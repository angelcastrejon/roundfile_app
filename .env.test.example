# =============================================================================
# Roundfile App — Test Environment
# =============================================================================
# Copy this file to .env.test and fill in the values:
#   cp .env.test.example .env.test
#
# These variables are used when running the test suite (RSpec / Minitest).
# Most defaults work out-of-the-box — only override what you need.
# =============================================================================

# --- Rails -------------------------------------------------------------------

RAILS_ENV=test

# Secret key for decrypting config/credentials.yml.enc
# RAILS_MASTER_KEY=

# --- Database ----------------------------------------------------------------

# By default Rails uses the "test" section in config/database.yml
# (roundfile_test). Override only if you need a different test database.
# DATABASE_URL=postgres://localhost/roundfile_test

# --- Server ------------------------------------------------------------------

# Max threads (default: 3). Keep low for test stability.
# RAILS_MAX_THREADS=3

# --- CI ----------------------------------------------------------------------

# Set by most CI providers (GitHub Actions, CircleCI, etc.) automatically.
# Controls behaviours like verbose backtraces and parallelised reporters.
# CI=true
