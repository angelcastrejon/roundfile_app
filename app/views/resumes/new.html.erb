<div class="max-w-md mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">New Resume</h1>

  <%= render "shared/error_messages", object: @resume %>

  <%= form_with model: @resume, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :name, "Resume Title", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :name, autofocus: true, placeholder: "e.g. Software Engineer Resume",
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-3 py-2 border" %>
    </div>

    <div>
      <%= f.submit "Create Resume", class: "w-full bg-indigo-600 hover:bg-indigo-500 text-white font-medium py-2 px-4 rounded-md cursor-pointer" %>
    </div>
  <% end %>
</div>
