<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-900">My Resumes</h1>
  <%= link_to "New Resume", new_resume_path, class: "bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded-md text-sm font-medium" %>
</div>

<% if @resumes.any? %>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @resumes.each do |resume| %>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
        <h3 class="font-semibold text-gray-900">
          <%= link_to resume.name, resume_path(resume), class: "hover:text-indigo-600" %>
        </h3>
        <p class="text-sm text-gray-400 mt-1">Updated <%= time_ago_in_words(resume.updated_at) %> ago</p>
        <div class="flex items-center gap-3 mt-3 text-sm">
          <span class="text-gray-500"><%= resume.sections.count %> sections</span>
          <span class="text-gray-500"><%= resume.comments.count %> comments</span>
        </div>
        <div class="mt-3 flex gap-2">
          <%= link_to "Edit", edit_resume_path(resume), class: "text-indigo-600 hover:text-indigo-500 text-sm" %>
          <%= button_to "Delete", resume_path(resume), method: :delete,
              data: { turbo_confirm: "Delete this resume?" },
              class: "text-red-600 hover:text-red-800 text-sm" %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-12">
    <p class="text-gray-500 mb-4">You haven't created any resumes yet.</p>
    <%= link_to "Create Your First Resume", new_resume_path, class: "text-indigo-600 hover:text-indigo-500 font-medium" %>
  </div>
<% end %>
