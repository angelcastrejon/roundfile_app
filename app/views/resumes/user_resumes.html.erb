<h1 class="text-2xl font-bold text-gray-900 mb-6">Browse Resumes by User</h1>

<div class="flex flex-wrap gap-2 mb-6">
  <% @users.each do |user| %>
    <%= link_to user.name,
        user_resumes_path(user_id: user.id),
        class: "px-3 py-1.5 rounded-full text-sm border #{@selected_user&.id == user.id ? 'bg-indigo-600 text-white border-indigo-600' : 'bg-white text-gray-700 border-gray-300 hover:bg-gray-50'}" %>
  <% end %>
</div>

<% if @selected_user %>
  <h2 class="text-lg font-semibold text-gray-900 mb-4"><%= @selected_user.name %>'s Resumes</h2>
  <% if @resumes.any? %>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @resumes.each do |resume| %>
        <%= render "resumes/resume_card", resume: resume %>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500">This user has no resumes.</p>
  <% end %>
<% else %>
  <p class="text-gray-500">Select a user above to see their resumes.</p>
<% end %>
