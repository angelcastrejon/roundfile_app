<div class="max-w-lg mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Edit Comment</h1>

  <%= render "shared/error_messages", object: @comment %>

  <%= form_with model: [@resume, @comment], class: "space-y-4" do |f| %>
    <div>
      <%= f.label :body, "Comment", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_area :body, rows: 4,
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-3 py-2 border" %>
    </div>

    <div class="flex gap-3">
      <%= f.submit "Update Comment", class: "bg-indigo-600 hover:bg-indigo-500 text-white font-medium py-2 px-4 rounded-md cursor-pointer" %>
      <%= link_to "Cancel", resume_path(@resume), class: "text-gray-600 hover:text-gray-800 py-2 px-4" %>
    </div>
  <% end %>
</div>
