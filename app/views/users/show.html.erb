<div class="flex items-start gap-6 mb-8">
  <%= image_tag @user.gravatar_url(size: 80), alt: @user.name, class: "rounded-full" %>
  <div>
    <h1 class="text-2xl font-bold text-gray-900"><%= @user.name %></h1>
    <p class="text-gray-500 text-sm">Member since <%= @user.created_at.strftime("%B %Y") %></p>
    <% if current_user == @user %>
      <%= link_to "Edit Profile", edit_user_path(@user), class: "text-indigo-600 hover:text-indigo-500 text-sm" %>
    <% end %>
  </div>
</div>

<h2 class="text-xl font-semibold text-gray-900 mb-4"><%= @user.name %>'s Resumes</h2>

<% if @resumes.any? %>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @resumes.each do |resume| %>
      <%= render "resumes/resume_card", resume: resume %>
    <% end %>
  </div>
<% else %>
  <p class="text-gray-500">No resumes yet.</p>
<% end %>
