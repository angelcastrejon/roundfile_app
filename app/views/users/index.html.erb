<h1 class="text-2xl font-bold text-gray-900 mb-6">All Users</h1>

<div class="space-y-3">
  <% @users.each do |user| %>
    <div class="flex items-center justify-between bg-white rounded-lg shadow-sm border border-gray-200 p-4">
      <div class="flex items-center gap-3">
        <%= image_tag user.gravatar_url(size: 40), alt: user.name, class: "rounded-full" %>
        <div>
          <%= link_to user.name, user_path(user), class: "font-medium text-gray-900 hover:text-indigo-600" %>
          <p class="text-sm text-gray-500"><%= user.resumes.count %> resumes</p>
        </div>
      </div>
      <% if current_user&.admin? && !current_user?(user) %>
        <%= button_to "Delete", user_path(user), method: :delete,
            data: { turbo_confirm: "Are you sure?" },
            class: "text-red-600 hover:text-red-800 text-sm" %>
      <% end %>
    </div>
  <% end %>
</div>

<div class="mt-6">
  <%== pagy_nav(@pagy) %>
</div>
