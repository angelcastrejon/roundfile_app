<%= render "shared/error_messages", object: section %>

<%= form_with model: section, class: "space-y-4" do |f| %>
  <div>
    <%= f.label :section_type, "Type", class: "block text-sm font-medium text-gray-700" %>
    <%= f.select :section_type,
        options_for_select(Section::TYPES, section.section_type),
        { prompt: "Select type..." },
        class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-3 py-2 border" %>
  </div>

  <div>
    <%= f.label :title, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :title, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-3 py-2 border" %>
  </div>

  <div>
    <%= f.label :content, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :content, rows: 8,
        class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-3 py-2 border" %>
  </div>

  <div>
    <%= f.submit class: "w-full bg-indigo-600 hover:bg-indigo-500 text-white font-medium py-2 px-4 rounded-md cursor-pointer" %>
  </div>
<% end %>
