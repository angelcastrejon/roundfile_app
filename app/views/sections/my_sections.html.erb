<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-900">My Sections</h1>
  <%= link_to "New Section", new_section_path, class: "bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded-md text-sm font-medium" %>
</div>

<% if @sections.any? %>
  <% Section::TYPES.each do |type| %>
    <% type_sections = @sections.select { |s| s.section_type == type } %>
    <% if type_sections.any? %>
      <h2 class="text-lg font-semibold text-gray-700 mt-6 mb-3"><%= type %></h2>
      <div class="space-y-2">
        <% type_sections.each do |section| %>
          <div class="flex items-center justify-between bg-white rounded-lg border border-gray-200 p-4">
            <div>
              <span class="font-medium text-gray-900"><%= section.title %></span>
              <p class="text-sm text-gray-500 mt-0.5 line-clamp-1"><%= truncate(section.content, length: 100) %></p>
            </div>
            <div class="flex gap-2 shrink-0">
              <%= link_to "View", section_path(section), class: "text-indigo-600 hover:text-indigo-500 text-sm" %>
              <%= link_to "Edit", edit_section_path(section), class: "text-gray-500 hover:text-gray-700 text-sm" %>
              <%= button_to "Delete", section_path(section), method: :delete,
                  data: { turbo_confirm: "Delete this section?" },
                  class: "text-red-600 hover:text-red-800 text-sm" %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% else %>
  <div class="text-center py-12">
    <p class="text-gray-500 mb-4">You haven't created any sections yet.</p>
    <p class="text-gray-400 text-sm">Sections are reusable blocks of content (Contact, Skills, Education, etc.) that you can add to multiple resumes.</p>
    <%= link_to "Create Your First Section", new_section_path, class: "inline-block mt-4 text-indigo-600 hover:text-indigo-500 font-medium" %>
  </div>
<% end %>
