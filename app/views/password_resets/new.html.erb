<div class="max-w-md mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Forgot your password?</h1>
  <p class="text-sm text-gray-600 mb-4">Enter your email and we'll send you a reset link.</p>

  <%= form_with url: password_resets_path, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :email, class: "block text-sm font-medium text-gray-700" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-3 py-2 border" %>
    </div>

    <div>
      <%= f.submit "Send reset link", class: "w-full bg-indigo-600 hover:bg-indigo-500 text-white font-medium py-2 px-4 rounded-md cursor-pointer" %>
    </div>
  <% end %>

  <p class="mt-4 text-sm text-gray-600 text-center">
    <%= link_to "Back to sign in", sign_in_path, class: "text-indigo-600 hover:text-indigo-500 font-medium" %>
  </p>
</div>
