<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-900">Comments <span class="text-gray-400 text-base font-normal">(<%= @pagy.count %>)</span></h1>
</div>

<div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Comment</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Author</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Resume</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @comments.each do |comment| %>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3 text-sm text-gray-700 max-w-xs truncate"><%= comment.body %></td>
          <td class="px-4 py-3">
            <%= link_to comment.user.name, admin_user_path(comment.user), class: "text-sm text-gray-500 hover:text-indigo-600" %>
          </td>
          <td class="px-4 py-3">
            <%= link_to comment.resume.name, admin_resume_path(comment.resume), class: "text-sm text-gray-500 hover:text-indigo-600" %>
          </td>
          <td class="px-4 py-3 text-sm text-gray-500"><%= comment.created_at.strftime("%b %d, %Y") %></td>
          <td class="px-4 py-3 text-right">
            <%= button_to "Delete", admin_comment_path(comment), method: :delete,
                data: { turbo_confirm: "Delete this comment?" },
                class: "text-red-600 hover:text-red-800 text-sm font-medium" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="mt-6">
  <%== pagy_nav(@pagy) %>
</div>
