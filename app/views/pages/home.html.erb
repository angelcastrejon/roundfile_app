<div class="text-center py-16">
  <h1 class="text-4xl font-bold text-gray-900 sm:text-5xl">
    Build &amp; Share Your Resume
  </h1>
  <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">
    Create modular resumes from reusable sections, share them with others,
    and get feedback through comments and ratings.
  </p>
  <div class="mt-8 flex justify-center gap-4">
    <% if signed_in? %>
      <%= link_to "My Resumes", my_resumes_path, class: "bg-indigo-600 hover:bg-indigo-500 text-white px-6 py-3 rounded-lg font-medium" %>
      <%= link_to "Browse Resumes", resumes_path, class: "bg-white hover:bg-gray-50 text-gray-700 border border-gray-300 px-6 py-3 rounded-lg font-medium" %>
    <% else %>
      <%= link_to "Get Started", sign_up_path, class: "bg-indigo-600 hover:bg-indigo-500 text-white px-6 py-3 rounded-lg font-medium" %>
      <%= link_to "Browse Resumes", resumes_path, class: "bg-white hover:bg-gray-50 text-gray-700 border border-gray-300 px-6 py-3 rounded-lg font-medium" %>
    <% end %>
  </div>
</div>
