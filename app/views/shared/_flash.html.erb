<% flash.each do |type, message| %>
  <% css_class = case type
    when "notice" then "bg-green-50 text-green-800 border-green-200"
    when "alert"  then "bg-red-50 text-red-800 border-red-200"
    else "bg-blue-50 text-blue-800 border-blue-200"
  end %>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-4" data-controller="flash">
    <div class="<%= css_class %> border rounded-md p-3 flex items-center justify-between text-sm">
      <span><%= message %></span>
      <button data-action="flash#dismiss" class="ml-4 opacity-50 hover:opacity-100">&times;</button>
    </div>
  </div>
<% end %>
