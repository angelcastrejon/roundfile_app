# =============================================================================
# Roundfile App — Development Environment
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# These variables are used when running the app locally in development mode.
# =============================================================================

# --- Rails -------------------------------------------------------------------

# Environment (leave as development for local work)
RAILS_ENV=development

# Secret key for decrypting config/credentials.yml.enc
# Find this in config/master.key (do NOT commit master.key to git)
# RAILS_MASTER_KEY=

# --- Database ----------------------------------------------------------------

# PostgreSQL connection settings.
# By default Rails connects via a local domain socket using your OS username.
# Uncomment and set these if your local Postgres requires explicit credentials.
# DATABASE_URL=postgres://localhost/roundfile_development

# --- Server ------------------------------------------------------------------

# Port Puma listens on (default: 3000)
# PORT=3000

# Max threads per Puma worker (default: 3)
# RAILS_MAX_THREADS=3

# Number of Puma worker processes (default: not set, single-process mode)
# Uncomment for multi-process mode — useful for simulating production locally.
# WEB_CONCURRENCY=2

# --- Background Jobs --------------------------------------------------------

# Run Solid Queue inside the Puma process (default: not set / false)
# Set to "true" to process jobs in-process instead of a separate worker.
# SOLID_QUEUE_IN_PUMA=true

# Number of concurrent job threads (default: 1)
# JOB_CONCURRENCY=1

# --- Logging -----------------------------------------------------------------

# Minimum log level: debug, info, warn, error, fatal, unknown (default: debug)
# RAILS_LOG_LEVEL=debug
