# =============================================================================
# Roundfile App — Production Environment (Railway)
# =============================================================================
# This file documents every env var the app reads in production.
# On Railway, set these in your service's "Variables" tab.
# Do NOT commit real secrets — this file is a reference only.
# =============================================================================

# --- Rails (required) --------------------------------------------------------

RAILS_ENV=production

# Master key to decrypt config/credentials.yml.enc (REQUIRED)
# Get this from config/master.key — treat it like a password.
RAILS_MASTER_KEY=<your-master-key>

# --- Database (required) ----------------------------------------------------

# Railway auto-provides this when you add a PostgreSQL plugin.
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=<provided-by-railway>

# Solid Cache/Queue/Cable share the primary DATABASE_URL by default.
# Set these only if you want separate databases:
# CACHE_DATABASE_URL=<postgres-url>
# QUEUE_DATABASE_URL=<postgres-url>
# CABLE_DATABASE_URL=<postgres-url>

# --- Server ------------------------------------------------------------------

# Railway sets PORT automatically — do not override.
# PORT=3000

# Max threads per Puma worker (default: 3)
RAILS_MAX_THREADS=5

# Number of Puma worker processes.
# Rule of thumb: match available vCPUs. Railway Hobby plan → 1–2.
# WEB_CONCURRENCY=2

# --- Host & SSL --------------------------------------------------------------

# Your production domain (used for mailer links and host authorization).
# Railway assigns a *.railway.app domain; set your custom domain here.
APP_HOST=your-app.railway.app

# --- Background Jobs --------------------------------------------------------

# Run Solid Queue inside the Puma process (single-dyno deploy).
# Set to "true" unless you run a separate worker service.
SOLID_QUEUE_IN_PUMA=true

# Concurrent job worker threads (default: 1)
JOB_CONCURRENCY=3

# --- Email (Resend) ----------------------------------------------------------

# Get your API key from https://resend.com/api-keys
# Used as the SMTP password (username is always "resend").
RESEND_API_KEY=re_xxxxxxxxxxxx

# --- Logging -----------------------------------------------------------------

# Minimum log level: debug, info, warn, error, fatal, unknown (default: info)
RAILS_LOG_LEVEL=info

# --- Error Tracking (Sentry) -------------------------------------------------

# Get your DSN from https://sentry.io → Project Settings → Client Keys
# Leave blank to disable Sentry.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Performance monitoring sample rate (0.0–1.0, default: 0.1 = 10%)
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Active Storage -----------------------------------------------------------

# Storage service name (matches a key in config/storage.yml).
# Default: "local" (ephemeral in containers — fine if not using uploads).
# Set to "amazon" after configuring S3 credentials in Rails credentials.
# ACTIVE_STORAGE_SERVICE=amazon
