# =============================================================================
# Roundfile App — Production Environment (Railway)
# =============================================================================
# This file documents every env var the app reads in production.
# On Railway, set these in your service's "Variables" tab.
# Do NOT commit real secrets — this file is a reference only.
# =============================================================================

# --- Rails (required) --------------------------------------------------------

RAILS_ENV=production

# Master key to decrypt config/credentials.yml.enc (REQUIRED)
# Get this from config/master.key — treat it like a password.
RAILS_MASTER_KEY=<your-master-key>

# --- Database (required) ----------------------------------------------------

# Railway auto-provides this when you add a PostgreSQL plugin.
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=<provided-by-railway>

# If you use separate databases for Solid Cache/Queue/Cable,
# set these as well (otherwise they fall back to DATABASE_URL):
# CACHE_DATABASE_URL=<postgres-url-for-cache-db>
# QUEUE_DATABASE_URL=<postgres-url-for-queue-db>
# CABLE_DATABASE_URL=<postgres-url-for-cable-db>

# Legacy per-field credentials (only if NOT using DATABASE_URL):
# ROUNDFILE_DATABASE_PASSWORD=<password>

# --- Server ------------------------------------------------------------------

# Railway sets PORT automatically — do not override.
# PORT=3000

# Max threads per Puma worker (default: 3)
RAILS_MAX_THREADS=5

# Number of Puma worker processes.
# Rule of thumb: match available vCPUs. Railway Hobby plan → 1–2.
# WEB_CONCURRENCY=2

# --- Background Jobs --------------------------------------------------------

# Run Solid Queue inside the Puma process (single-dyno deploy).
# Set to "true" unless you run a separate worker service.
SOLID_QUEUE_IN_PUMA=true

# Concurrent job worker threads (default: 1)
JOB_CONCURRENCY=3

# --- Logging -----------------------------------------------------------------

# Minimum log level: debug, info, warn, error, fatal, unknown (default: info)
RAILS_LOG_LEVEL=info

# --- Optional / Future -------------------------------------------------------

# Custom PID file path (Puma). Usually not needed in containers.
# PIDFILE=/tmp/puma.pid

# SMTP credentials for Action Mailer (password reset, notifications, etc.)
# Store these in Rails credentials or set here:
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=<username>
# SMTP_PASSWORD=<password>
# SMTP_DOMAIN=roundfile.example.com

# Active Storage — switch from local disk to S3 for persistent uploads:
# AWS_ACCESS_KEY_ID=<key>
# AWS_SECRET_ACCESS_KEY=<secret>
# AWS_BUCKET=roundfile-production
# AWS_REGION=us-east-1
